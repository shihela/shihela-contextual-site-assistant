{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=shihela-contextual-site-assistant",
  "preferredVersions": {
    "php": "8.1",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "shihela-contextual-site-assistant"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "shihela_contextual_site_assistant_bot_name": "Shihela AI",
        "shihela_contextual_site_assistant_welcome_message": "Hello! I am your AI assistant. How can I help you today?",
        "shihela_contextual_site_assistant_theme_color": "#4f46e5",
        "shihela_contextual_site_assistant_widget_position": "bottom-right",
        "shihela_contextual_site_assistant_suggestion_chips": "How can you help me?\nWhat services are offered?\nHow to contact human support?",
        "shihela_contextual_site_assistant_whatsapp_message": "Halo CS/Admin, saya sedang melihat halaman {page_title} ({page_url}) dan membutuhkan bantuan.",
        "shihela_contextual_site_assistant_whatsapp_header_btn": "1"
      }
    }
  ]
}
